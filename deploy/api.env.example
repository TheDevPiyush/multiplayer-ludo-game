# Template for the API_ENV secret (GitHub → Settings → Environments → production).
# Paste the filled-in file as the secret's value; every deploy writes it to the droplet
# as /opt/simple-ludo/api.env. Every variable is described in server/.env.example.

# Supabase transaction pooler (:6543) for the app, session pooler (:5432) for migrations.
DATABASE_URL=""
DIRECT_URL=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""

# App links: SHA-256 of every key that signs the Android app (upload key and the Play
# app signing key, from Play Console → Test and release → App integrity), comma-separated.
ANDROID_CERT_SHA256=""
# <TeamID>.com.thedevpiyush.simpleludo, once there is an iOS build.
IOS_APP_ID=""
PLAY_STORE_URL="https://play.google.com/store/apps/details?id=com.thedevpiyush.simpleludo"
APP_STORE_URL=""

LOG_LEVEL=info
DICE_BALANCE_STRENGTH=0.6
