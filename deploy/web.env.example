# Template for the optional WEB_ENV secret (GitHub → Settings → Environments → production).
# The website reads these when a page is served, for the admin console (/admin-console).
# Nothing here is secret: the publishable (anon) key is meant for browsers.

# Supabase → Project Settings → API.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
# The game API the console talks to (defaults to production).
API_URL="https://api.simple-ludo.thedevpiyush.com"

# AdMob publisher ID ("pub-…", AdMob → Settings → Account): served as /app-ads.txt.
ADMOB_PUBLISHER_ID=
