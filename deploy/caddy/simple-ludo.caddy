# Simple Ludo's sites. This server's existing Caddy (the ERP stack's proxy) owns ports
# 80/443 and imports /opt/caddy-sites/*.caddy; release.sh copies this file there and
# reloads it. The upstream names are aliases on the shared `edge` Docker network.
# HTTPS certificates are issued and renewed automatically once DNS points here.

# Game API: REST + Socket.IO (WebSocket upgrades pass through reverse_proxy as-is).
api.simple-ludo.thedevpiyush.com {
	encode zstd gzip
	reverse_proxy simple-ludo-api:8080
}

# Website and invite pages.
simple-ludo.thedevpiyush.com {
	encode zstd gzip

	# App link verification files come from the API (ANDROID_CERT_SHA256 / IOS_APP_ID),
	# so this domain's /invite/* links open the installed app directly.
	handle /.well-known/assetlinks.json {
		reverse_proxy simple-ludo-api:8080
	}
	handle /.well-known/apple-app-site-association {
		reverse_proxy simple-ludo-api:8080
	}

	handle {
		reverse_proxy simple-ludo-web:3000
	}
}

www.simple-ludo.thedevpiyush.com {
	redir https://simple-ludo.thedevpiyush.com{uri} permanent
}
