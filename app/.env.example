EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
EXPO_PUBLIC_API_URL=""

# EAS cloud builds don't read this file (it's gitignored): the same variables live in
# EAS → Project → Environment variables (development / preview / production).

# Domain for shareable invite links (https://<domain>/invite/ABC123). Leave empty to use
# EXPO_PUBLIC_API_URL. The server at this domain must serve /invite/* and /.well-known/*
# (the website does, see deploy/README.md; so does the API server). Changing it needs a
# new native build (npx expo run:android / EAS).
# Production: EXPO_PUBLIC_API_URL="https://api.simple-ludo.thedevpiyush.com"
EXPO_PUBLIC_LINK_URL="https://simple-ludo.thedevpiyush.com"

# Must match Supabase → Auth → Email → OTP length
EXPO_PUBLIC_OTP_LENGTH=6

# Crash reports (sentry.io). Empty = off. Add it to EAS environment variables too.
# Readable stack traces also need SENTRY_AUTH_TOKEN, SENTRY_ORG and SENTRY_PROJECT on EAS (see app.config.ts).
EXPO_PUBLIC_SENTRY_DSN=

# Ads (Google AdMob). Unit IDs from AdMob → Apps → Ad units. Without them, development builds show
# Google's test ads and release builds show none. Never tap your own live ads.
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=
EXPO_PUBLIC_ADMOB_REWARDED_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=
# Build-time (EAS environment variables, then a new native build): the AdMob app IDs ("ca-app-pub-…~…").
# Without them the build uses Google's sample app IDs, which only serve test ads.
# ADMOB_ANDROID_APP_ID=
# ADMOB_IOS_APP_ID=
