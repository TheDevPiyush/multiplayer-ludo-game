EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
EXPO_PUBLIC_API_URL=""

# EAS cloud builds don't read this file (it's gitignored): the same variables live in
# EAS → Project → Environment variables (development / preview / production).

# Domain for shareable invite links (https://<domain>/invite/ABC123). Leave empty to use
# EXPO_PUBLIC_API_URL. The server at this domain must serve /invite/* and /.well-known/*
# (the website does, see deploy/README.md; so does the API server). Changing it needs a
# new native build (npx expo run:android / EAS).
# Production: EXPO_PUBLIC_API_URL="https://api.simple-ludo.thedevpiyush.com"
EXPO_PUBLIC_LINK_URL="https://simple-ludo.thedevpiyush.com"

# Must match Supabase → Auth → Email → OTP length
EXPO_PUBLIC_OTP_LENGTH=6
