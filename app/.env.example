EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
EXPO_PUBLIC_API_URL=""

# Domain for shareable invite links (https://<domain>/join/ABC123). Leave empty to use
# EXPO_PUBLIC_API_URL. The server at this domain must serve /join/* and /.well-known/*
# (the API server does). Changing it needs a new native build (npx expo run:android / EAS).
EXPO_PUBLIC_LINK_URL=""

# TURN credentials are fetched from the server at runtime (GET /rtc/ice-servers).
# No client-side TURN env vars needed when using Cloudflare via the API.

# Must match Supabase → Auth → Email → OTP length
EXPO_PUBLIC_OTP_LENGTH=6
