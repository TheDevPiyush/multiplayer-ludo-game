{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "ios-sideload": {
      "environment": "preview",
      "withoutCredentials": true,
      "ios": {
        "config": "ios-sideload.yml",
        "buildConfiguration": "Release"
      }
    },
    "ios-sideload-dev": {
      "extends": "ios-sideload",
      "developmentClient": true,
      "environment": "development",
      "ios": {
        "buildConfiguration": "Debug"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
