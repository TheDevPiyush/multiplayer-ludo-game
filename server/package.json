{
  "name": "server",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch index.ts",
    "start": "bun run index.ts",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "db:migrate": "bunx --bun prisma migrate deploy",
    "db:generate": "bunx --bun prisma generate"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/node": "^25.7.0",
    "prisma": "^7.8.0",
    "socket.io-client": "4.8.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.105.4",
    "crypto": "^1.0.1",
    "dotenv": "17.2.3",
    "express": "^5.2.1",
    "jose": "6.1.0",
    "pg": "^8.20.0",
    "socket.io": "^4.8.3"
  }
}
