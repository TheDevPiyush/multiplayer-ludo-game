PORT=8080
# App runtime — Supabase transaction pooler (port 6543) is fine here.
DATABASE_URL=""
# Migrations — same URL but session pooler port 5432 (no pgbouncer=true).
DIRECT_URL=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Optional: legacy (HS256) JWT secret from Supabase → Settings → API. Lets the server
# verify tokens locally. Projects on the new asymmetric signing keys need nothing extra
# (keys are fetched from SUPABASE_URL's JWKS endpoint and cached).
SUPABASE_JWT_SECRET=""

# Optional: Redis for live game snapshots (survive restarts). e.g. Upstash free tier.
REDIS_URL=""

# Optional: Cloudflare Realtime TURN (interim, until LiveKit).
CLOUDFLARE_TURN_KEY_ID=""
CLOUDFLARE_TURN_API_TOKEN=""

# Comma-separated origins for web builds. Mobile apps don't need CORS.
CORS_ORIGINS=""

# Gameplay tuning (ms)
TURN_MS=15000
AFK_TURN_MS=2500
AUTO_DELAY_MS=900
# How long a dropped player has to reconnect before their turns go on autopilot.
DISCONNECT_GRACE_MS=15000
# Dirty live games are written to Postgres this often.
FLUSH_MS=10000

# Dice balancing: 0 = fair dice, 1 = strongest catch-up. See PLAN.md.
DICE_BALANCE_STRENGTH=0.6

# debug = also log every socket event + DB flushes
LOG_LEVEL=info
