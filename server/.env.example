PORT=8080
# App runtime — Supabase transaction pooler (port 6543) is fine here.
DATABASE_URL=""
# Migrations — same URL but session pooler port 5432 (no pgbouncer=true).
DIRECT_URL=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Optional: legacy (HS256) JWT secret from Supabase → Settings → API. Lets the server
# verify tokens locally. Projects on the new asymmetric signing keys need nothing extra
# (keys are fetched from SUPABASE_URL's JWKS endpoint and cached).
SUPABASE_JWT_SECRET=""

# Optional: Redis for live game snapshots (survive restarts). e.g. Upstash free tier.
REDIS_URL=""

# LiveKit (voice chat). LIVEKIT_URL is the wss:// project URL, e.g. LiveKit Cloud.
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Comma-separated origins for web builds. Mobile apps don't need CORS.
CORS_ORIGINS=""

# Gameplay tuning (ms)
TURN_MS=15000
AFK_TURN_MS=2500
AUTO_DELAY_MS=900
# How long a dropped player has to reconnect before their turns go on autopilot.
DISCONNECT_GRACE_MS=15000
# Dirty live games are written to Postgres this often.
FLUSH_MS=10000
# With nobody connected, autopilot stops after this long and the game waits for someone to rejoin…
UNWATCHED_PAUSE_MS=60000
# …and is ended as abandoned (no stats) after this long.
ABANDON_MS=600000

# Proxy hops in front of the server (tunnel / load balancer), so rate limits see the real client IP.
TRUST_PROXY_HOPS=1

# Dice balancing: 0 = fair dice, 1 = strongest catch-up. See PLAN.md.
DICE_BALANCE_STRENGTH=0.6

# debug = also log every socket event + DB flushes
LOG_LEVEL=info

# Shareable room links (https://<this host>/join/ABC123). SHA-256 fingerprints of every
# key that signs the Android app (debug keystore, upload key, Play app signing key),
# comma-separated — Android only opens the app directly when one matches.
ANDROID_CERT_SHA256=""
# iOS universal links: <TeamID>.com.thedevpiyush.simpleludo
IOS_APP_ID=""
PLAY_STORE_URL=""
APP_STORE_URL=""

# Push notifications (Expo). Only needed with "Enhanced push security" on in the Expo project.
EXPO_ACCESS_TOKEN=""
# "Come and play" reminders: send times (HH:MM, comma-separated) in the zone below; "" turns them off.
REMINDER_TIMES="13:00,19:30"
# Minutes east of UTC for REMINDER_TIMES (India = 330).
REMINDER_UTC_OFFSET_MIN=330
# No reminders for people who haven't opened the app in this many days.
REMINDER_DORMANT_DAYS=30
# "Friend is online" pushes: only after this long away; each person announced at most every N hours,
# and each person told about friends at most every M hours.
FRIEND_ONLINE_AWAY_MIN=30
FRIEND_ONLINE_ACTOR_HOURS=6
FRIEND_ONLINE_RECIPIENT_HOURS=3
