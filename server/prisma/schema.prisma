generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum GameStatus {
  WAITING
  PLAYING
  FINISHED
  CANCELLED
}

enum PlayerColor {
  RED
  BLUE
  GREEN
  YELLOW
}

enum PlayerStatus {
  CONNECTED
  DISCONNECTED
  LEFT
}

enum MoveAction {
  MOVE
  CAPTURE
  ENTER_HOME
  SAFE
  WIN
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum ReportReason {
  ABUSE
  CHEATING
  USERNAME
  OTHER
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  ROOM_INVITE
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(uuid())
  username          String    @unique
  isAdmin           Boolean   @default(false)
  avatarUrl         String?
  provider          String?
  providerId        String?
  totalWins         Int       @default(0)
  totalGames        Int       @default(0)
  /// Last username change; changes are limited to one a week (the first is free).
  usernameChangedAt DateTime?
  /// Expo push tokens of the user's most recent devices, newest first (at most 3).
  pushTokens        String[]  @default([])
  /// Last time the app synced its push token (each Home visit): activity, for reminders.
  lastSeenAt        DateTime?
  /// Last "come and play" reminder, so a restart near a send time doesn't send it twice.
  lastReminderAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  gamePlayers  GamePlayer[]
  createdRooms GameRoom[]   @relation("RoomCreator")
  gameMoves    GameMove[]

  sentFriendRequests     Friendship[]   @relation("FriendRequester")
  receivedFriendRequests Friendship[]   @relation("FriendAddressee")
  notifications          Notification[] @relation("NotificationRecipient")
  notificationsSent      Notification[] @relation("NotificationActor")

  blocks       Block[]  @relation("Blocker")
  blockedBy    Block[]  @relation("Blocked")
  reportsMade  Report[] @relation("Reporter")
  reportsAbout Report[] @relation("Reported")

  @@index([providerId])
  @@index([lastSeenAt])
  /// Prefix search ("pi" → piyush_1234); usernames are stored lowercase.
  @@index([username(ops: raw("text_pattern_ops"))], map: "User_username_pattern_idx")
}

model GameRoom {
  id           String     @id @default(uuid())
  gameCode     String     @unique
  status       GameStatus @default(WAITING)
  maxPlayers   Int        @default(4)
  isPrivate    Boolean    @default(false)
  voiceEnabled Boolean    @default(true)

  currentTurnColor  PlayerColor?
  currentTurnUserId String?
  currentDice       Int?
  winnerId          String?

  /// Engine snapshot (@ludo/engine GameState) — written in batches, not per move.
  gameState    Json?
  stateVersion Int   @default(0)
  /// Every move of a finished game, compact ([color, token, dice, from, to, tenths of s]) — see MoveEntry.
  moveLog      Json?

  createdById String
  createdBy   User   @relation("RoomCreator", fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  startedAt DateTime?
  endedAt   DateTime?

  players GamePlayer[]
  moves   GameMove[]

  @@index([gameCode])
  @@index([status])
  @@index([status, createdAt])
}

model GamePlayer {
  id             String       @id @default(uuid())
  gameRoomId     String
  userId         String
  seatNumber     Int
  color          PlayerColor
  status         PlayerStatus @default(CONNECTED)
  isReady        Boolean      @default(false)
  rank           Int?
  tokenPositions Int[]        @default([0, 0, 0, 0])
  joinedAt       DateTime     @default(now())
  leftAt         DateTime?

  gameRoom GameRoom @relation(fields: [gameRoomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameRoomId, seatNumber])
  @@unique([gameRoomId, color])
  @@unique([gameRoomId, userId])
  @@index([gameRoomId])
  @@index([userId, joinedAt])
}

/// Legacy: one row per move, no longer written (finished games keep `GameRoom.moveLog`).
model GameMove {
  id           String     @id @default(uuid())
  gameRoomId   String
  userId       String
  tokenIndex   Int
  diceValue    Int
  fromPosition Int
  toPosition   Int
  actionType   MoveAction
  createdAt    DateTime   @default(now())

  gameRoom GameRoom @relation(fields: [gameRoomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gameRoomId])
  @@index([userId])
}

/// One row per pair of users. A pending request is requester → addressee;
/// declining or unfriending deletes the row.
model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  requester     User           @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee     User           @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model Notification {
  id           String           @id @default(uuid())
  userId       String
  type         NotificationType
  actorId      String
  friendshipId String?
  /// ROOM_INVITE: the room to join.
  gameCode     String?
  readAt       DateTime?
  createdAt    DateTime         @default(now())

  user       User        @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor      User        @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  friendship Friendship? @relation(fields: [friendshipId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([userId, actorId, gameCode])
}

/// `blocker` blocked `blocked`: neither sees the other's emotes or chat, and
/// they can't friend or invite each other. Blocking also unfriends.
model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

/// A player report, reviewed by hand (no admin screen yet). `evidence` holds what the
/// reported player said in the room at the time, as the server only keeps chat in memory.
model Report {
  id               String       @id @default(uuid())
  reporterId       String
  reportedId       String
  reason           ReportReason
  note             String?
  /// The room it happened in, if any (no foreign key: rooms can be deleted).
  gameRoomId       String?
  /// Username at the time — they may change it.
  reportedUsername String
  evidence         Json?
  createdAt        DateTime     @default(now())
  resolvedAt       DateTime?

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([reportedId, createdAt])
  @@index([reporterId, reportedId, createdAt])
  @@index([resolvedAt, createdAt])
}
