generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum GameStatus {
  WAITING
  PLAYING
  FINISHED
  CANCELLED
}

enum PlayerColor {
  RED
  BLUE
  GREEN
  YELLOW
}

enum PlayerStatus {
  CONNECTED
  DISCONNECTED
  LEFT
}

enum MoveAction {
  MOVE
  CAPTURE
  ENTER_HOME
  SAFE
  WIN
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum ReportReason {
  ABUSE
  CHEATING
  USERNAME
  OTHER
}

/// How an item was got. Store purchases (later) carry the store's id in `externalId`.
enum EntitlementSource {
  COINS
  PLAY
  APPSTORE
  REWARD
  ADMIN
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  ROOM_INVITE
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(uuid())
  username          String    @unique
  isAdmin           Boolean   @default(false)
  avatarUrl         String?
  provider          String?
  providerId        String?
  totalWins         Int       @default(0)
  totalGames        Int       @default(0)
  /// Last username change; changes are limited to one a week (the first is free).
  usernameChangedAt DateTime?
  /// Expo push tokens of the user's most recent devices, newest first (at most 3).
  pushTokens        String[]  @default([])
  /// Last time the app synced its push token (each Home visit): activity, for reminders.
  lastSeenAt        DateTime?
  /// Last "come and play" reminder, so a restart near a send time doesn't send it twice.
  lastReminderAt    DateTime?
  /// Earned by playing, never bought; spent on cosmetics. `CoinLedger` has every change.
  coins             Int       @default(0)
  xp                Int       @default(0)
  /// Daily rewards claimed on consecutive days (India time).
  dailyStreak       Int       @default(0)
  /// India date of the last daily reward, "2026-11-10".
  dailyClaimDay     String?
  /// Equipped cosmetics (shop item ids, e.g. "pawn.crown"); null is the free default.
  /// Others see the pawn and dice in games; the board is only ever the player's own view.
  pawnSkin          String?
  diceSkin          String?
  boardTheme        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  gamePlayers  GamePlayer[]
  createdRooms GameRoom[]   @relation("RoomCreator")
  gameMoves    GameMove[]

  sentFriendRequests     Friendship[]   @relation("FriendRequester")
  receivedFriendRequests Friendship[]   @relation("FriendAddressee")
  notifications          Notification[] @relation("NotificationRecipient")
  notificationsSent      Notification[] @relation("NotificationActor")

  blocks       Block[]  @relation("Blocker")
  blockedBy    Block[]  @relation("Blocked")
  reportsMade  Report[] @relation("Reporter")
  reportsAbout Report[] @relation("Reported")

  coinLedger      CoinLedger[]
  missionProgress MissionProgress[]
  entitlements    Entitlement[]
  purchases       Purchase[]

  @@index([providerId])
  @@index([lastSeenAt])
  /// Prefix search ("pi" → piyush_1234); usernames are stored lowercase.
  @@index([username(ops: raw("text_pattern_ops"))], map: "User_username_pattern_idx")
}

model GameRoom {
  id           String     @id @default(uuid())
  gameCode     String     @unique
  status       GameStatus @default(WAITING)
  maxPlayers   Int        @default(4)
  isPrivate    Boolean    @default(false)
  voiceEnabled Boolean    @default(true)

  currentTurnColor  PlayerColor?
  currentTurnUserId String?
  currentDice       Int?
  winnerId          String?

  /// Engine snapshot (@ludo/engine GameState) — written in batches, not per move.
  gameState    Json?
  stateVersion Int   @default(0)
  /// Every move of a finished game, compact ([color, token, dice, from, to, tenths of s]) — see MoveEntry.
  moveLog      Json?

  createdById String
  createdBy   User   @relation("RoomCreator", fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  startedAt DateTime?
  endedAt   DateTime?

  players GamePlayer[]
  moves   GameMove[]

  @@index([gameCode])
  @@index([status])
  @@index([status, createdAt])
}

model GamePlayer {
  id             String       @id @default(uuid())
  gameRoomId     String
  userId         String
  seatNumber     Int
  color          PlayerColor
  status         PlayerStatus @default(CONNECTED)
  isReady        Boolean      @default(false)
  rank           Int?
  tokenPositions Int[]        @default([0, 0, 0, 0])
  joinedAt       DateTime     @default(now())
  leftAt         DateTime?

  gameRoom GameRoom @relation(fields: [gameRoomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameRoomId, seatNumber])
  @@unique([gameRoomId, color])
  @@unique([gameRoomId, userId])
  @@index([gameRoomId])
  @@index([userId, joinedAt])
}

/// Legacy: one row per move, no longer written (finished games keep `GameRoom.moveLog`).
model GameMove {
  id           String     @id @default(uuid())
  gameRoomId   String
  userId       String
  tokenIndex   Int
  diceValue    Int
  fromPosition Int
  toPosition   Int
  actionType   MoveAction
  createdAt    DateTime   @default(now())

  gameRoom GameRoom @relation(fields: [gameRoomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gameRoomId])
  @@index([userId])
}

/// One row per pair of users. A pending request is requester → addressee;
/// declining or unfriending deletes the row.
model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  requester     User           @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee     User           @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model Notification {
  id           String           @id @default(uuid())
  userId       String
  type         NotificationType
  actorId      String
  friendshipId String?
  /// ROOM_INVITE: the room to join.
  gameCode     String?
  readAt       DateTime?
  createdAt    DateTime         @default(now())

  user       User        @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor      User        @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  friendship Friendship? @relation(fields: [friendshipId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([userId, actorId, gameCode])
}

/// `blocker` blocked `blocked`: neither sees the other's emotes or chat, and
/// they can't friend or invite each other. Blocking also unfriends.
model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

/// A player report, reviewed by hand (no admin screen yet). `evidence` holds what the
/// reported player said in the room at the time, as the server only keeps chat in memory.
model Report {
  id               String       @id @default(uuid())
  reporterId       String
  reportedId       String
  reason           ReportReason
  note             String?
  /// The room it happened in, if any (no foreign key: rooms can be deleted).
  gameRoomId       String?
  /// Username at the time — they may change it.
  reportedUsername String
  evidence         Json?
  createdAt        DateTime     @default(now())
  resolvedAt       DateTime?

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([reportedId, createdAt])
  @@index([reporterId, reportedId, createdAt])
  @@index([resolvedAt, createdAt])
}

/// A push sent from the admin console, kept as an audit log.
model AdminBroadcast {
  id         String   @id @default(uuid())
  title      String
  body       String
  /// App route opened on tap ("/" = home).
  url        String   @default("/")
  /// "all", or "users" for a hand-picked list.
  audience   String
  /// Users that had a device to send to.
  recipients Int      @default(0)
  /// Devices Expo accepted the push for.
  devices    Int      @default(0)
  sentById   String
  sentBy     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// A notice shown in the app (a modal, on opening and after sign-in) between `startsAt` and `endsAt`.
model Announcement {
  id          String   @id @default(uuid())
  /// Shown in the modal's header.
  title       String
  /// Body, as HTML from the admin console's editor (rendered in a WebView).
  html        String
  startsAt    DateTime
  endsAt      DateTime
  /// "all", "accounts" (signed-in, not guests), "guests", or "users" (only `userIds`).
  audience    String   @default("all")
  userIds     String[] @default([])
  /// Shown again on every app open while live; otherwise once per device.
  everyOpen   Boolean  @default(false)
  /// Higher shows first when several are live.
  priority    Int      @default(0)
  /// Paused announcements are never shown, whatever the dates.
  active      Boolean  @default(true)
  createdById String
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, startsAt, endsAt])
}

/// Every change to a user's coins, append-only. `key` is unique, so each grant happens once
/// (a retried game finish, a double-tapped claim).
model CoinLedger {
  id        String   @id @default(uuid())
  userId    String
  /// Positive when earned, negative when spent.
  amount    Int
  /// GAME, OFFLINE_GAME, DAILY, MISSION, LEVEL_UP, INVITE, INVITE_HOST or SHOP (later also AD).
  reason    String
  /// e.g. "game:<roomId>:<userId>", "daily:<userId>:<day>".
  key       String   @unique
  /// India date it counts toward, for daily caps.
  day       String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, reason, day])
  @@index([userId, createdAt])
}

/// Progress on one of a user's daily missions. Which missions a user gets on a day is worked
/// out from their id and the day (progress/rules.ts), so only progress is stored.
model MissionProgress {
  userId    String
  /// India date, "2026-11-10".
  day       String
  missionId String
  progress  Int       @default(0)
  claimedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day, missionId])
}

/// A cosmetic a user owns (shop item ids live in code: shop/catalog.ts). One row per user and item.
model Entitlement {
  id         String            @id @default(uuid())
  userId     String
  itemId     String
  source     EntitlementSource
  /// A store's purchase id, so one purchase grants once.
  externalId String?           @unique
  /// Null: owned for good. Otherwise a trial that ends then.
  expiresAt  DateTime?
  createdAt  DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

/// A paid purchase, as RevenueCat reports it (server/purchases). Its items are `Entitlement`
/// rows with source PLAY or APPSTORE, worked out again on every sync.
model Purchase {
  id                 String    @id @default(uuid())
  /// The account holding it. Null once that account is deleted (the record stays, without
  /// personal details, for refunds and tax), or while a restore has moved it to an account
  /// that hasn't synced yet.
  userId             String?
  /// Store product id (server/shop/products.ts).
  productId          String
  /// RevenueCat's id for this purchase.
  rcId               String    @unique
  /// The store's order id (Play: "GPA.…"). Refund events name it.
  storeTransactionId String?   @unique
  /// RevenueCat's store name: play_store, app_store.
  store              String
  /// A licence tester's or TestFlight purchase: nothing was charged.
  sandbox            Boolean   @default(false)
  purchasedAt        DateTime
  /// Refunded or revoked: it grants nothing, even if RevenueCat lists it again.
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}
